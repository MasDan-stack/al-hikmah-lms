APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PAKASIR_API_KEY=
PAKASIR_PROJECT_SLUG=
PAKASIR_BASE_URL=https://app.pakasir.com/api
PAKASIR_WEBHOOK_URL=
PAKASIR_FEE_PAYER=customer
PAKASIR_FEE_QRIS_PERCENT=0.7
PAKASIR_FEE_VA_FLAT=3500

# ==========================================
# UNIVERSAL MULTI-PROVIDER AI CONFIGURATION
# ==========================================
# Pilihan AI_PROVIDER: auto | gemini | deepseek | qwen | claude | openai
AI_PROVIDER=auto

# Kredensial Universal
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_MAX_RETRIES=2
AI_TIMEOUT=45

# 1. Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_TEXT_MODEL=gemini-3.7-flash

# 2. DeepSeek AI (https://platform.deepseek.com)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat

# 3. Alibaba Qwen (https://dashscope.aliyun.com)
QWEN_API_KEY=your-qwen-api-key-here
QWEN_MODEL=qwen-plus

# 4. Anthropic Claude (https://console.anthropic.com)
CLAUDE_API_KEY=your-claude-api-key-here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# 5. OpenAI ChatGPT (https://platform.openai.com)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini


